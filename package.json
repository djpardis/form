{
  "name": "form",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:public-identifiers": "node scripts/check-public-identifiers.mjs",
    "smoke": "bash scripts/smoke-local.sh",
    "email:test": "node scripts/send-test-email.mjs",
    "db:migrate:local": "wrangler d1 migrations apply form_submissions --local",
    "db:migrate": "wrangler d1 migrations apply form_submissions --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "vitest": "^4.1.6",
    "wrangler": "latest"
  }
}
