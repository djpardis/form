FORM_CONFIG='{
  "contact": {
    "allowedOrigins": ["localhost"],
    "requiredFields": ["email", "eventDate", "message"],
    "emailFields": ["email"],
    "dateFields": ["eventDate"],
    "maxLinks": 3,
    "turnstile": false,
    "notification": {
      "subject": "New contact form submission",
      "replyToField": "email"
    }
  }
}'

IP_HASH_SECRET="replace-with-random-local-string"

# Leave these blank to store submissions without sending email. Set all three,
# with EMAIL_FROM on a domain verified in Resend, to send real notifications.
RESEND_API_KEY=
NOTIFICATION_TO=
EMAIL_FROM=
